#!/bin/sh

set -eu

version=0.4.0

usage() {
  cat <<'EOF'
Usage: apc COMMAND [OPTIONS] [TARGET]

Commands:
  init TARGET       Add missing continuity files to a project
  check [--staleness COMMITS] [TARGET]
                    Validate a project; optionally warn about stale task state
  report [TARGET]   Print a privacy-safe Markdown conformance report
  bundle [TARGET]   Print core continuity context for a manual handoff
  hook              Print a reviewable pre-commit hook without installing it
  version           Print the installed version
  help              Show this help
EOF
}

resolve_root() {
  if [ -n "${APC_HOME:-}" ] && [ -d "$APC_HOME/scripts" ] && [ -d "$APC_HOME/template" ]; then
    printf '%s\n' "$APC_HOME"
    return
  fi

  script=$0
  case $script in
    */*) ;;
    *)
      if [ -f "$script" ]; then
        script=./$script
      else
        script=$(command -v "$script" 2>/dev/null || printf '%s' "$script")
      fi
      ;;
  esac
  bin_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)

  if [ -d "$bin_dir/scripts" ] && [ -d "$bin_dir/template" ]; then
    printf '%s\n' "$bin_dir"
  elif [ -d "$bin_dir/../share/ai-project-continuity/scripts" ] && [ -d "$bin_dir/../share/ai-project-continuity/template" ]; then
    CDPATH= cd -- "$bin_dir/../share/ai-project-continuity" && pwd
  else
    printf 'error: cannot locate the ai-project-continuity bundle\n' >&2
    printf 'hint: reinstall with scripts/install.sh or set APC_HOME\n' >&2
    exit 2
  fi
}

root=$(resolve_root)
command_name=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case $command_name in
  init)
    if [ "$#" -ne 1 ]; then
      printf 'error: init requires exactly one target directory\n' >&2
      usage >&2
      exit 2
    fi
    exec sh "$root/scripts/init.sh" "$1"
    ;;
  check)
    staleness=
    if [ "${1:-}" = "--staleness" ]; then
      if [ "$#" -lt 2 ]; then
        printf 'error: --staleness requires a positive commit count\n' >&2
        exit 2
      fi
      staleness=$2
      case $staleness in
        ''|*[!0-9]*)
          printf 'error: --staleness requires a positive commit count\n' >&2
          exit 2
          ;;
      esac
      if [ "$staleness" -eq 0 ]; then
        printf 'error: --staleness requires a positive commit count\n' >&2
        exit 2
      fi
      shift 2
    fi
    if [ "$#" -gt 1 ]; then
      printf 'error: check accepts at most one target directory\n' >&2
      usage >&2
      exit 2
    fi
    APC_STALENESS_THRESHOLD=$staleness exec sh "$root/scripts/check.sh" "${1:-.}"
    ;;
  report)
    if [ "$#" -gt 1 ]; then
      printf 'error: report accepts at most one target directory\n' >&2
      usage >&2
      exit 2
    fi
    target=${1:-.}
    if ! sh "$root/scripts/check.sh" "$target" >/dev/null; then
      printf 'error: cannot report conformance because validation failed\n' >&2
      exit 1
    fi
    target_dir=$(CDPATH= cd -- "$target" && pwd)
    project_name=$(basename "$target_dir")
    revision=not-versioned
    if git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      revision=$(git -C "$target_dir" rev-parse --short HEAD 2>/dev/null || printf 'uncommitted')
    fi
    generated=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    cat <<EOF
# AI project continuity conformance report

- Project: $project_name
- Status: pass
- Validator: ai-project-continuity $version
- Revision: $revision
- Generated (UTC): $generated
- Required continuity files: present
- Placeholder scan: pass
- Privacy and secret-shaped content scan: pass
- Tracked sensitive filename scan: pass
EOF
    ;;
  bundle)
    if [ "$#" -gt 1 ]; then
      printf 'error: bundle accepts at most one target directory\n' >&2
      usage >&2
      exit 2
    fi
    target=${1:-.}
    if ! sh "$root/scripts/check.sh" "$target" >/dev/null; then
      printf 'error: refusing to create a bundle because validation failed\n' >&2
      exit 1
    fi
    printf 'warning: automated checks cannot detect every private detail; review the bundle before sharing it\n' >&2
    cat <<'EOF'
# APC context bundle

> Review this generated document before sharing it with any person or service.

EOF
    for path in AGENTS.md .ai/context.md .ai/decisions.md .ai/tasks.md; do
      printf '## `%s`\n\n' "$path"
      cat "$target/$path"
      printf '\n\n'
    done
    ;;
  hook)
    if [ "$#" -ne 0 ]; then
      printf 'error: hook does not accept arguments\n' >&2
      usage >&2
      exit 2
    fi
    cat <<'EOF'
#!/bin/sh
set -eu

# Generated by `apc hook`. Review before installing or composing with an
# existing hook. This script intentionally depends on an installed `apc`.
repo_root=$(git rev-parse --show-toplevel)
if ! command -v apc >/dev/null 2>&1; then
  printf 'error: apc is required by the continuity pre-commit hook\n' >&2
  exit 1
fi
exec apc check "$repo_root"
EOF
    ;;
  version|--version|-V)
    printf 'ai-project-continuity %s\n' "$version"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    printf 'error: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
