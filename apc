#!/bin/sh

set -eu

version=0.5.0

usage() {
  cat <<'EOF'
Usage: apc COMMAND [OPTIONS] [TARGET]

Commands:
  init TARGET       Add missing continuity files to a project
  check [--staleness COMMITS|DAYS|WEEKS] [TARGET]
                    Validate a project; optionally warn about stale task state
  report [TARGET]   Print a privacy-safe Markdown conformance report
  bundle [--minimal] [--resources] [TARGET]
                    Print core or token-constrained continuity context
  hook [--shell sh|powershell]
                    Print a reviewable pre-commit hook without installing it
  version           Print the installed version
  help              Show this help
EOF
}

resolve_root() {
  if [ -n "${APC_HOME:-}" ] && [ -d "$APC_HOME/scripts" ] && [ -d "$APC_HOME/template" ]; then
    printf '%s\n' "$APC_HOME"
    return
  fi

  script=$0
  case $script in
    */*) ;;
    *)
      if [ -f "$script" ]; then
        script=./$script
      else
        script=$(command -v "$script" 2>/dev/null || printf '%s' "$script")
      fi
      ;;
  esac
  bin_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)

  if [ -d "$bin_dir/scripts" ] && [ -d "$bin_dir/template" ]; then
    printf '%s\n' "$bin_dir"
  elif [ -d "$bin_dir/../share/ai-project-continuity/scripts" ] && [ -d "$bin_dir/../share/ai-project-continuity/template" ]; then
    CDPATH= cd -- "$bin_dir/../share/ai-project-continuity" && pwd
  else
    printf 'error: cannot locate the ai-project-continuity bundle\n' >&2
    printf 'hint: reinstall with scripts/install.sh or set APC_HOME\n' >&2
    exit 2
  fi
}

root=$(resolve_root)
command_name=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case $command_name in
  init)
    if [ "$#" -ne 1 ]; then
      printf 'error: init requires exactly one target directory\n' >&2
      usage >&2
      exit 2
    fi
    exec sh "$root/scripts/init.sh" "$1"
    ;;
  check)
    staleness=
    if [ "${1:-}" = "--staleness" ]; then
      if [ "$#" -lt 2 ]; then
        printf 'error: --staleness requires a positive commit count, days (e.g. 3d), or weeks (e.g. 1w)\n' >&2
        exit 2
      fi
      staleness=$2
      case $staleness in
        *d) staleness_number=${staleness%d} ;;
        *w) staleness_number=${staleness%w} ;;
        *) staleness_number=$staleness ;;
      esac
      case $staleness_number in
        ''|*[!0-9]*|0)
          printf 'error: --staleness requires a positive commit count, days (e.g. 3d), or weeks (e.g. 1w)\n' >&2
          exit 2
          ;;
      esac
      shift 2
    fi
    if [ "$#" -gt 1 ]; then
      printf 'error: check accepts at most one target directory\n' >&2
      usage >&2
      exit 2
    fi
    APC_STALENESS_THRESHOLD=$staleness exec sh "$root/scripts/check.sh" "${1:-.}"
    ;;
  report)
    if [ "$#" -gt 1 ]; then
      printf 'error: report accepts at most one target directory\n' >&2
      usage >&2
      exit 2
    fi
    target=${1:-.}
    if ! sh "$root/scripts/check.sh" "$target" >/dev/null; then
      printf 'error: cannot report conformance because validation failed\n' >&2
      exit 1
    fi
    target_dir=$(CDPATH= cd -- "$target" && pwd)
    project_name=$(basename "$target_dir")
    revision=not-versioned
    if git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      revision=$(git -C "$target_dir" rev-parse --short HEAD 2>/dev/null || printf 'uncommitted')
    fi
    generated=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    cat <<EOF
# AI project continuity conformance report

- Project: $project_name
- Status: pass
- Validator: ai-project-continuity $version
- Revision: $revision
- Generated (UTC): $generated
- Required continuity files: present
- Placeholder scan: pass
- Privacy and secret-shaped content scan: pass
- Tracked sensitive filename scan: pass
EOF
    ;;
  bundle)
    include_resources=
    minimal=
    target=
    while [ "$#" -gt 0 ]; do
      case $1 in
        --resources)
          include_resources=1
          ;;
        --minimal)
          minimal=1
          ;;
        --help|-h)
          usage
          exit 0
          ;;
        --*)
          printf 'error: unknown bundle option: %s\n' "$1" >&2
          usage >&2
          exit 2
          ;;
        *)
          if [ -n "$target" ]; then
            printf 'error: bundle accepts at most one target directory\n' >&2
            usage >&2
            exit 2
          fi
          target=$1
          ;;
      esac
      shift
    done
    target=${target:-.}
    if ! sh "$root/scripts/check.sh" "$target" >/dev/null; then
      printf 'error: refusing to create a bundle because validation failed\n' >&2
      exit 1
    fi
    printf 'warning: automated checks cannot detect every private detail; review the bundle before sharing it\n' >&2
    section_body() {
      section_file=$1
      section_heading=$2
      awk -v heading="$section_heading" '
        $0 == heading { found=1; next }
        found && /^## / { exit }
        found { print }
        END { if (!found) exit 1 }
      ' "$section_file"
    }
    print_minimal_section() {
      section_title=$1
      section_file=$2
      section_heading=$3
      printf '## %s\n\n' "$section_title"
      section_content=$(section_body "$section_file" "$section_heading" 2>/dev/null || true)
      if [ -n "$section_content" ]; then
        printf '%s\n\n' "$section_content"
      else
        printf '_No entries recorded for `%s`._\n\n' "$section_heading"
      fi
    }
    if [ -n "$minimal" ]; then
      printf '# APC minimal context bundle\n\n'
      printf '> This reduced bundle is intended for token-constrained handoffs. Review it before sharing.\n\n'
      print_minimal_section 'Durable constraints' "$target/.ai/context.md" '## Durable constraints'
      print_minimal_section 'Current task' "$target/.ai/tasks.md" '## Doing'
      print_minimal_section 'Next entry point' "$target/.ai/tasks.md" '## Next'
      print_minimal_section 'Blockers' "$target/.ai/tasks.md" '## Blocked'
      print_minimal_section 'Handoff evidence' "$target/.ai/tasks.md" '## Handoff'

      latest_session=
      if [ -d "$target/.ai/sessions" ]; then
        latest_session=$(find "$target/.ai/sessions" -type f -name '*.md' \
          ! -name 'README.md' ! -name '_template.md' ! -name '*.local.md' \
          -print | sort | tail -n 1)
      fi
      printf '## Latest session\n\n'
      if [ -n "$latest_session" ]; then
        printf '_Source: `%s`_\n\n' "${latest_session#"$target"/}"
        cat "$latest_session"
        printf '\n\n'
      else
        printf '_No published session summary was found._\n\n'
      fi

      if [ -n "$include_resources" ] && [ -f "$target/.ai/resources.md" ]; then
        printf '## `.ai/resources.md`\n\n'
        cat "$target/.ai/resources.md"
        printf '\n\n'
        printf 'warning: resource locators may reveal internal names; review this section before sharing\n' >&2
      fi
      exit 0
    fi
    cat <<'EOF'
# APC context bundle

> Review this generated document before sharing it with any person or service.

EOF
    for path in AGENTS.md .ai/context.md .ai/decisions.md .ai/tasks.md; do
      printf '## `%s`\n\n' "$path"
      cat "$target/$path"
      printf '\n\n'
    done
    if [ -n "$include_resources" ] && [ -f "$target/.ai/resources.md" ]; then
      printf '## `.ai/resources.md`\n\n'
      cat "$target/.ai/resources.md"
      printf '\n\n'
      printf 'warning: resource locators may reveal internal names; review this section before sharing\n' >&2
    fi
    ;;
  hook)
    hook_shell=sh
    if [ "$#" -gt 0 ]; then
      if [ "$#" -ne 2 ] || [ "$1" != '--shell' ]; then
        printf 'error: hook accepts only --shell sh|powershell\n' >&2
        usage >&2
        exit 2
      fi
      hook_shell=$2
    fi
    case $hook_shell in
      sh|posix)
        ;;
      powershell|pwsh)
        cat <<'EOF'
$ErrorActionPreference = 'Stop'

$repoRoot = (& git rev-parse --show-toplevel 2>$null | Select-Object -First 1).Trim()
if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($repoRoot)) {
  Write-Error 'error: the PowerShell hook must run inside a Git repository'
  exit 1
}

$apc = @('apc', 'apc.ps1', 'apc.cmd', 'apc.exe') |
  ForEach-Object { Get-Command $_ -ErrorAction SilentlyContinue } |
  Select-Object -First 1
if ($null -eq $apc) {
  Write-Error 'error: apc is not on the PATH used by Git; install it or add its bin directory to PATH'
  exit 1
}

& $apc.Source check $repoRoot
exit $LASTEXITCODE
EOF
        exit 0
        ;;
      *)
        printf 'error: unsupported hook shell: %s (choose sh or powershell)\n' "$hook_shell" >&2
        usage >&2
        exit 2
        ;;
    esac
    if [ "$#" -ne 0 ] && [ "$#" -ne 2 ]; then
      printf 'error: hook accepts only --shell sh|powershell\n' >&2
      usage >&2
      exit 2
    fi
    cat <<'EOF'
#!/bin/sh
set -eu

# Generated by `apc hook`. Review before installing or composing with an
# existing hook. This script intentionally depends on an installed `apc`.
repo_root=$(git rev-parse --show-toplevel)
if ! command -v apc >/dev/null 2>&1; then
  printf 'error: apc is required by the continuity pre-commit hook\n' >&2
  exit 1
fi
exec apc check "$repo_root"
EOF
    ;;
  version|--version|-V)
    printf 'ai-project-continuity %s\n' "$version"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    printf 'error: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
